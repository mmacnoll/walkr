# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Browser key: Maps JavaScript API only, restricted by HTTP referrer.
# The NEXT_PUBLIC_ prefix means this value IS sent to the browser (that's expected for this key).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-key-here

# Map ID from Google Cloud Console > Map Management (needed for modern markers).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id-here

# Server key: Places API (New) + Routes API only. Used only in Next.js API routes.
# No NEXT_PUBLIC_ prefix, so it never reaches the browser.
GOOGLE_MAPS_SERVER_KEY=your-server-key-here
